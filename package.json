{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.js && node scripts/validate-seo.js",
    "preview": "vite preview",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test scripts/*.test.js src/data/*.test.ts src/utils/*.test.ts",
    "validate:seo": "node scripts/validate-seo.js"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.0.0",
    "fast-xml-parser": "^5.11.2",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
